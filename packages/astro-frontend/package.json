    "@storybook/react-vite": "9.1.15",
    "@types/node": "catalog:",
    "@types/qs": "6.9.15",
    "pagopa-interop-public-eslint-config": "workspace:*",
    "pagopa-interop-public-typescript-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-astro": "0.14.1",
    "storybook": "9.1.19",
    "testcontainers": "11.8.1",
    "typescript": "catalog:",
