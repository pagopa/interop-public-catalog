{
  "name": "pagopa-interop-public-astro-frontend",
  "version": "1.3.2",
  "description": "Public catalog frontend built with Astro",
  "main": "dist",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "start": "astro dev",
    "build": "astro build",
    "check": "tsc --noEmit && astro check",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/node": "10.0.5",
    "@astrojs/react": "^5.0.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.4",
    "@types/pg": "catalog:",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "accessible-autocomplete": "^3.0.1",
    "astro": "^6.0.0",
    "axios": "catalog:",
    "bootstrap-italia": "2.16.2",
    "design-react-kit": "5.8.3",
    "dotenv-flow": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "5.2.1",
    "mixpanel-browser": "2.71.0",
    "nuqs": "2.7.2",
    "pagopa-interop-public-commons": "workspace:*",
    "pagopa-interop-public-models": "workspace:*",
    "pg": "catalog:",
    "qs": "6.14.2",
