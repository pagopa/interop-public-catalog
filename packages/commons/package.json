{
  "name": "pagopa-interop-public-commons",
  "private": true,
  "version": "1.0.0",
  "description": "PagoPA Interoperability common utilities",
  "main": "dist",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pagopa-interop-public-eslint-config": "workspace:*",
    "pagopa-interop-public-typescript-config": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
